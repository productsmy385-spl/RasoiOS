datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserTenantStatus {
  ACTIVE
  INACTIVE
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  CASHIER
  KITCHEN
  WAITER
}

enum DailyMenuStatus {
  DRAFT
  PUBLISHED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
  REFUNDED
}

enum KOTStatus {
  QUEUED
  PREPARING
  READY
  SERVED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  ONLINE
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PrintJobStatus {
  PENDING
  PROCESSING
  PRINTED
  FAILED
}

enum PrintJobType {
  KOT
  RECEIPT
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

model Tenant {
  id         String       @id @default(uuid())
  name       String
  slug       String       @unique
  timezone   String       @default("UTC") // IANA format e.g. "Asia/Kolkata"
  status     TenantStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  restaurants    Restaurant[]
  userTenants    UserTenant[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  dailyMenus     DailyMenu[]
  customers      Customer[]
  orders         Order[]
  kotTickets     KOTTicket[]
  transactions   Transaction[]
  printJobs      PrintJob[]
  auditLogs      AuditLog[]
  socialPosts    SocialPost[]

  @@map("tenants")
}

model Restaurant {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  logo         String?
  description  String?
  address      String?
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  openingHours Json?    @map("opening_hours")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("restaurants")
}

model User {
  id        String     @id @default(uuid())
  clerkId   String     @unique @map("clerk_id")
  email     String     @unique
  fullName  String?    @map("full_name")
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  userTenants UserTenant[]
  auditLogs   AuditLog[]

  @@map("users")
}

model UserTenant {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  tenantId  String           @map("tenant_id")
  role      Role
  status    UserTenantStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId, role])
  @@map("user_tenants")
}

model MenuCategory {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  menuItems MenuItem[]

  @@index([tenantId, isActive])
  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  categoryId  String   @map("category_id")
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  price       Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2) @map("tax_rate")
  isAvailable Boolean  @default(true) @map("is_available")
  displayOrder Int     @default(0) @map("display_order")
  variants    Json?
  addOns      Json?    @map("add_ons")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category       MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  dailyMenuItems DailyMenuItem[]

  @@index([tenantId, categoryId])
  @@index([tenantId, isAvailable])
  @@map("menu_items")
}

model DailyMenu {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  date      DateTime        @db.Date
  status    DailyMenuStatus @default(DRAFT)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  items  DailyMenuItem[]

  @@unique([tenantId, date])
  @@map("daily_menus")
}

model DailyMenuItem {
  id          String @id @default(uuid())
  dailyMenuId String @map("daily_menu_id")
  menuItemId  String @map("menu_item_id")
  displayOrder Int   @default(0) @map("display_order")

  dailyMenu DailyMenu @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([dailyMenuId, menuItemId])
  @@map("daily_menu_items")
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orders Order[]

  @@index([tenantId, phone])
  @@map("customers")
}

model Order {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  orderNumber String      @map("order_number")
  orderType   OrderType   @default(DINE_IN) @map("order_type")
  status      OrderStatus @default(NEW)
  tableNumber String?     @map("table_number")
  totalAmount Decimal     @db.Decimal(12, 2) @map("total_amount")
  customerId  String?     @map("customer_id")
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  kotTickets   KOTTicket[]
  transactions Transaction[]
  printJobs    PrintJob[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String   @map("order_id")
  menuItemId          String?  @map("menu_item_id")
  itemNameSnapshot    String   @map("item_name_snapshot")
  priceSnapshot       Decimal  @db.Decimal(12, 2) @map("price_snapshot")
  taxRateSnapshot     Decimal  @default(0) @db.Decimal(5, 2) @map("tax_rate_snapshot")
  quantity            Int
  specialInstructions String?  @map("special_instructions")
  optionsSnapshot     Json?    @map("options_snapshot")
  createdAt           DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model KOTTicket {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  orderId        String    @map("order_id")
  kotNumber      String    @map("kot_number")
  kitchenSection String?   @map("kitchen_section")
  status         KOTStatus @default(QUEUED)
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  printJobs PrintJob[]

  @@index([tenantId, status])
  @@map("kot_tickets")
}

model Transaction {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  orderId       String            @map("order_id")
  amount        Decimal           @db.Decimal(12, 2)
  paymentMethod PaymentMethod     @map("payment_method")
  status        TransactionStatus @default(PENDING)
  referenceId   String?           @map("reference_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("transactions")
}

model PrintJob {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  orderId       String?        @map("order_id")
  kotTicketId   String?        @map("kot_ticket_id")
  jobType       PrintJobType   @map("job_type")
  targetPrinter String         @map("target_printer")
  payload       Json
  status        PrintJobStatus @default(PENDING)
  attempts      Int            @default(0)
  errorLog      String?        @map("error_log")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  kotTicket KOTTicket? @relation(fields: [kotTicketId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("print_jobs")
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  actorUserId  String?  @map("actor_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  beforeState  Json?    @map("before_state")
  afterState   Json?    @map("after_state")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model SocialPost {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  platform    String
  content     String
  mediaUrl    String?          @map("media_url")
  status      SocialPostStatus @default(DRAFT)
  scheduledAt DateTime?        @map("scheduled_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("social_posts")
}
