# ============================================================
# RESTAURANT SaaS PLATFORM (RASOIOS) ENVIRONMENT CONFIGURATION
# ============================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rasoios_db?schema=public"

# Clerk Authentication (Email OTP)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder_key"
CLERK_SECRET_KEY="sk_test_placeholder_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Logging & Observability
LOG_LEVEL="debug"
