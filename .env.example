# ============================================================
# Restaurant SaaS Platform (RASOIOS) — environment variables
# ============================================================
# Validated at server boot by lib/env.ts (S1-P01-T004). The server refuses to start when a value is
# missing, malformed, or still a placeholder. The dummy values below intentionally FAIL validation:
# replace every one. Never commit real values (.env is gitignored).

# --- Database (PostgreSQL) -------------------------------------------------
# Local: `npm run db:local` (embedded PostgreSQL 16) or `docker compose up -d postgres`.
# Production must include ?sslmode=require (SC-DB-01).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rasoios_db?schema=public"

# --- Clerk (Email OTP authentication) ---------------------------------------
# Use a Clerk *development* instance locally and on staging; the production instance only in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder_key"
CLERK_SECRET_KEY="sk_test_placeholder_key"
# Svix signing secret for /api/webhooks/clerk (optional until S1-P03-T008, then required).
# CLERK_WEBHOOK_SIGNING_SECRET="whsec_placeholder"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# --- Application ------------------------------------------------------------
# Absolute URL; must be https in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# OPTIONAL (S1-P09-T011, RASOIOS-ADR-012). Wildcard domain that serves each restaurant's public website at
# <slug>.<domain>, e.g. "rasoios.com" → https://spice-route.rasoios.com. A bare domain only: no scheme, port or path.
# Production needs a *.<domain> DNS record and a wildcard TLS certificate before setting it.
# LEAVE IT UNSET and everything still works: the console stays on the apex host, <slug>.localhost serves the public
# site in development, /r/{slug} keeps working everywhere, and no canonical link to a sub-domain is emitted.
PUBLIC_ROOT_DOMAIN=""
# Image host allowlist for logo, cover and menu item image URLs (S1-P07-T002, SC-VAL-04). Comma-separated
# hostnames only (no scheme, port, path, wildcard or IP), exact match, e.g. "images.unsplash.com,cdn.example.com".
# Image URLs must then be https://<allowed host>/… with no credentials or port. Also feeds next/image
# remotePatterns (next.config.ts, read at build/start). Empty = no image URLs accepted. Set per environment.
ALLOWED_IMAGE_HOSTS=""

# ImageKit image uploads, storage and CDN (RASOIOS-ADR-017). Both or neither; blank = uploads off (image-link fields
# keep working). Uploads go browser → this server → ImageKit, so only the server needs these. The private key is a
# secret: set it in the host's variables (Railway/Render), never in a NEXT_PUBLIC_ variable and never in git.
# The endpoint's host (ik.imagekit.io) is added to the image allow-list automatically.
# ImageKit dashboard → Developer options → API keys / URL endpoint.
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""
# Number of trusted reverse-proxy hops for client IP extraction (S1-P23-T003). 0 locally.
TRUSTED_PROXY_HOPS="0"
# Email granted SUPER_ADMIN by the seed / platform:grant-super-admin command (optional).
# SUPER_ADMIN_BOOTSTRAP_EMAIL="owner@example.com"

# --- Logging ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL="debug"
